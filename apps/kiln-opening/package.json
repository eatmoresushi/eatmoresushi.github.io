    "selfplay:v104:population:002": "node --no-warnings --experimental-strip-types src/ai/runV104PopulationStudy.ts --population-002 --output playtests/v1.0.4/population-002",
    "selfplay:v104:population:002:quick": "node --no-warnings --experimental-strip-types src/ai/runV104PopulationStudy.ts --population-002 --quick --output playtests/v1.0.4/population-002-quick",
    "selfplay:v104:population:003": "node --no-warnings --experimental-strip-types src/ai/runV104PopulationStudy.ts --population-003 --output playtests/v1.0.4/population-003",
    "selfplay:v104:population:003:quick": "node --no-warnings --experimental-strip-types src/ai/runV104PopulationStudy.ts --population-003 --quick --output playtests/v1.0.4/population-003-quick",
    "selfplay:v109:baseline": "node --no-warnings --experimental-strip-types src/ai/runV109BaselineStudy.ts --games-per-count 50 --output playtests/v1.0.9/v109-v003-compat-001",
    "selfplay:v109:population:prepare": "node --no-warnings --experimental-strip-types src/ai/runV109PopulationPrecommit.ts --output playtests/v1.0.9/v109-population-001/precommit",
