    "selfplay:v109:population:quick": "node --no-warnings --experimental-strip-types src/ai/runV109PopulationStudy.ts --quick --output playtests/v1.0.9/v109-population-001-quick",
    "selfplay:v109:population:confirm": "node --no-warnings --experimental-strip-types src/ai/runV109PopulationConfirmatory.ts",
    "experiment:jun-ab-001": "node --no-warnings --experimental-strip-types src/ai/runJunAbExperiment.ts",
    "experiment:imperial-track-ab-001": "node --no-warnings --experimental-strip-types src/ai/runImperialTrackExperiment.ts"
