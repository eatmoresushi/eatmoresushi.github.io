{
  "rulesVersion": "1.6.1",
  "clarifications": {
    "starting": [
      {
        "en": "Starting Orders never enter the Main Order deck and have no Crowns; if discarded from your hand during Cleanup, return them to the box. They are Orders for all rules and Kiln Tradition abilities. A player is never required to complete a Starting Order.",
        "zh": "起始委托永远不进入主委托牌堆，也没有御令；若在收工时从手中弃置，放回盒中。对所有规则与窑口传承能力而言，起始委托都算作委托。玩家没有义务完成任何起始委托。",
        "source": "L521"
      },
      {
        "en": "Only Orders in your hand can be completed.",
        "zh": "只能完成在手委托。",
        "source": "L297"
      },
      {
        "en": "The Order Phase is a single pass in First Player order. A player with nothing completable is skipped automatically.",
        "zh": "交货阶段按起始玩家顺序依次进行一遍，不再循环；没有可完成委托的玩家自动跳过。",
        "source": "INT Order Phase"
      },
      {
        "en": "An Order may also be completed through Canal Barge, which counts for every completion effect.",
        "zh": "委托也可以通过漕船完成，对所有完成委托时的效果都算作完成委托。",
        "source": "R6"
      },
      {
        "en": "A ceramic may satisfy only one completed Order.",
        "zh": "一件器物只能用于一张委托。",
        "source": "L419"
      },
      {
        "en": "Flawed ceramics cannot complete Orders.",
        "zh": "瑕品不能用于完成委托。",
        "source": "L279"
      },
      {
        "en": "When completing an Order, each of your Crackle ceramics may count as having any one Decoration for that Order's Decoration requirements. Its printed Decoration is unchanged.",
        "zh": "完成委托时，你的每件开片器都可以视为具有任意一种纹饰，以满足该委托的纹饰要求；它原本的纹饰不变。",
        "source": "L470"
      },
      {
        "en": "Starting Orders and reserved Main Orders both count toward your hand limit of 4 (5 with Colour Samples), checked only at Cleanup.",
        "zh": "起始委托与承接的主委托都计入委托上限4张（有色样簿则为5张），只在收工时检查。",
        "source": "L200 · L304"
      },
      {
        "en": "In Round 5 the hand trim has no scoring effect and is skipped.",
        "zh": "第5轮收工时不削减委托（对计分没有影响）。",
        "source": "INT Cleanup in Round 5"
      },
      {
        "en": "Orders in hand are secret information. The number of Orders in each player's hand is public.",
        "zh": "手中的委托是秘密信息。每位玩家手中的委托张数公开。",
        "source": "L507"
      },
      {
        "en": "Uncompleted Orders have no end-game penalty.",
        "zh": "未完成的委托在终局不扣分。",
        "source": "L510"
      }
    ],
    "main": [
      {
        "en": "Face-up Main Orders cannot be completed; they are reserved at the Commission Market during the Work Phase.",
        "zh": "委托榜上的主委托不能完成；它们要在派工阶段于瓷牙行承接。",
        "source": "L297"
      },
      {
        "en": "A held Order can be completed during any later Order Phase, or with Canal Barge.",
        "zh": "在手委托可以在之后任何一个交货阶段完成，或通过漕船完成。",
        "source": "L403"
      },
      {
        "en": "Canal Barge completes an Order for every completion effect, including Ru, Guan, Tribute Ware and Crackle wildcards.",
        "zh": "对所有完成委托时的效果而言，漕船都算作完成委托：会触发汝窑、官窑与贡瓷，开片器也可以作任意一种纹饰。",
        "source": "R6"
      },
      {
        "en": "The Order Phase is a single pass in First Player order. A player with nothing completable is skipped automatically.",
        "zh": "交货阶段按起始玩家顺序依次进行一遍，不再循环；没有可完成委托的玩家自动跳过。",
        "source": "INT Order Phase"
      },
      {
        "en": "Requirements are independent unless a specific pairing is explicitly printed.",
        "zh": "各项要求彼此独立，除非卡面直接写明配对。",
        "source": "L423"
      },
      {
        "en": "A ceramic may satisfy only one completed Order.",
        "zh": "一件器物只能用于一张委托。",
        "source": "L419"
      },
      {
        "en": "Flawed ceramics cannot complete Orders.",
        "zh": "瑕品不能用于完成委托。",
        "source": "L279"
      },
      {
        "en": "Each Crackle ceramic may count as having any one Decoration for that Order's Decoration requirements; its printed Decoration is unchanged.",
        "zh": "每件开片器都可以视为具有任意一种纹饰，以满足该委托的纹饰要求；它原本的纹饰不变。",
        "source": "L470 · INT Ge Crackle"
      },
      {
        "en": "A Crackle ceramic cannot fill a Masterpiece requirement, including Painted Masterpiece Orders.",
        "zh": "开片器不能满足任何臻品要求，包括画花臻品委托。",
        "source": "L654"
      },
      {
        "en": "Resolve 1 Crown at a time. Each Crown advances Imperial Recognition by 1 until you reach Recognition 4; after that, each further Crown scores 1 VP immediately. Resolve every milestone crossed.",
        "zh": "逐个结算御令。每个御令使御府声望推进1格，直到声望4。到达声望4之后，此后每个御令立即得1分。途经的每一格奖励都要结算。",
        "source": "L416"
      },
      {
        "en": "Tribute Ware's bonus Crown is not a printed Crown: it does not trigger Guan and does not count for tie-breaker 2.",
        "zh": "贡瓷的额外御令不是委托上印有的御令：它不触发官窑，也不计入平局判定②。",
        "source": "R13"
      },
      {
        "en": "Tie-breaker 2 counts Crown icons printed across completed Orders.",
        "zh": "平局判定②统计已完成委托上印的御令总数。",
        "source": "L498"
      },
      {
        "en": "At the start of Rounds 2–5, discard the 2 leftmost face-up Main Orders, slide the remaining 4 left and reveal 2 new Orders to restore the display to 6.",
        "zh": "第2–5轮开工时轮换委托榜：弃置最左边的2张主委托，余下4张向左推，再翻开2张新委托，使委托榜恢复为6张。",
        "source": "L128 · L130"
      },
      {
        "en": "If the deck and discard are both empty, only available cards can be reserved and display positions stay empty. The round-start rotation discards up to 2 and slides the rest.",
        "zh": "如果主委托牌堆和弃牌堆都空了，只能承接现有的牌，榜位就空着；开工轮换至多弃置2张，其余的向左推。",
        "source": "B1"
      },
      {
        "en": "The Main Order discard pile is face down; only its count is public. Display Orders discarded at round start were already public.",
        "zh": "主委托弃牌堆面朝下，只公开张数；开工时弃置的榜上委托本来就是公开的。",
        "source": "B3"
      },
      {
        "en": "Starting Orders and reserved Main Orders both count toward your hand limit of 4 (5 with Colour Samples), checked only at Cleanup. Discarded Main Orders go to the Main Order discard pile.",
        "zh": "起始委托与承接的主委托都计入委托上限4张（有色样簿则为5张），只在收工时检查；弃置的主委托进入主委托弃牌堆。",
        "source": "L200 · L304"
      },
      {
        "en": "In Round 5 the hand trim has no scoring effect and is skipped.",
        "zh": "第5轮收工时不削减委托（对计分没有影响）。",
        "source": "INT Cleanup in Round 5"
      },
      {
        "en": "Orders in hand are secret information. The number of Orders in each player's hand is public.",
        "zh": "手中的委托是秘密信息。每位玩家手中的委托张数公开。",
        "source": "L507"
      },
      {
        "en": "Uncompleted Orders have no end-game penalty.",
        "zh": "未完成的委托在终局不扣分。",
        "source": "L510"
      }
    ]
  },
